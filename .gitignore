# Environment and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
secrets.yaml
**/secrets.yaml

# Dependencies
node_modules/
**/node_modules/

# CRE generated artifacts
.cre_build_tmp*
**/.cre_build_tmp*
.cre/
**/.cre/

# Solidity and Hardhat generated artifacts
# Hardhat 3 writes artifacts/ and cache/ at the REPOSITORY ROOT, not under
# contracts/. The contracts/-prefixed rules below never matched anything and
# left both directories publishable.
artifacts/
**/artifacts/
cache/
**/cache/
typechain-types/
**/typechain-types/
contracts/typechain-types/
contracts/coverage/
contracts/.openzeppelin/

# Generic build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
coverage/
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# Deployment archives — the repository publishes sources, never packages
*.zip

# Temporary and partial files
*.partial
*.tmp
*.temp
*~
.*.swp

# Wallet and private-key containers
keystore/
**/keystore/
wallets/
**/wallets/
*.keystore
*.wallet
private-key*
private_key*
*.private-key
*.private_key

# Local executables and operating-system files
*.exe
.DS_Store
Thumbs.db
Desktop.ini
